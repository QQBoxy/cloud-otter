{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-otter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-otter-local",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_IP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "otter.qqboxy.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloud-otter-production",
          "database_id": "594c49b0-e42b-4176-9318-5412f5763d73"
        }
      ],
      "ratelimits": [
        {
          "name": "LOGIN_IP_LIMIT",
          "namespace_id": "84731629",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "secrets": {
        "required": [
          "ADMIN_1_USERNAME",
          "ADMIN_1_PASSWORD_HASH",
          "ADMIN_2_USERNAME",
          "ADMIN_2_PASSWORD_HASH",
          "SESSION_KEY"
        ]
      }
    }
  }
}
